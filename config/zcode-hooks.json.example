{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/pre-commit-gate.mjs"],
              "timeoutMs": 180000,
              "statusMessage": "Прогоняю гейт качества перед коммитом…"
            }
          ]
        }
      ]
    }
  }
}
