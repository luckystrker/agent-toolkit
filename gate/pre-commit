#!/usr/bin/env node
/**
 * agent-toolkit quality gate — один файл, два режима:
 *
 *  1. git pre-commit (универсально): git вызывает этот файл сам —
 *     проверка выполняется всегда, как бы ни был запущен коммит.
 *  2. PreToolUse-адаптер (ZCode / Claude Code): читает JSON-payload из stdin
 *     и гейтит только команды `git commit`. В этом режиме дополнительно
 *     блокирует попытки агента обойти проверки: `--no-verify`/`-n`,
 *     подмену `core.hooksPath`, самоодобрение через AGENT_TOOLKIT_HUMAN_APPROVED.
 *
 * Порядок (схема доверия: «пока скрипты красные, агент код не оценивает»):
 *  1. сверка рабочего дерева с индексом — гейт проверяет то, что уйдёт в коммит;
 *  2. защищённые пути (необратимое: деньги, касса, внешние системы) — коммит
 *     в них только с одобрением человека;
 *  3. гейты по порядку, fail-fast, таймаут на каждый.
 *
 * Гейты: из `.agents/gate.json` (`gates: [{name, run}]` — любые команды, не только npm),
 * иначе `npm run --if-present lint|typecheck|complexity|test|tlc` — те, что объявлены.
 *
 * `.agents/gate.json` (всё опционально):
 *   { "gates": [{ "name": "lint", "run": "ruff check ." }, ...],
 *     "timeoutSec": 120,
 *     "protected": ["src/billing/**", "migrations/**"] }
 *
 * Коды выхода: 0 = пропустить, 2 = блокировать, другое ненулевое = ошибка хука.
 * Нет ни gate.json, ни package.json с гейт-скриптами — проход С ПРЕДУПРЕЖДЕНИЕМ
 * (fail-open объявлен явно, а не молча).
 *
 * Файл намеренно без расширения — git ищет хуки по точному имени. Поэтому
 * здесь нет static import/require: расширение-less файл загружается как CJS
 * или ESM в зависимости от "type" в package.json проекта, а динамический
 * import() работает в обоих режимах на любом Node ≥ 18.
 */
main().catch((e) => {
  console.error(`[gate] внутренняя ошибка: ${e?.stack ?? e}`);
  process.exit(1);
});

async function main() {
  const { spawnSync } = await import("node:child_process");
  const { existsSync, readFileSync } = await import("node:fs");
  const { homedir } = await import("node:os");
  const { basename, dirname, join, resolve } = await import("node:path");

  // --- где мы: хук проекта (<репо>/.githooks/pre-commit) или глобальный хук harness'а ---

  const scriptDir = dirname(resolve(process.argv[1]));
  const inRepoHook = basename(scriptDir) === ".githooks";
  const rawStdin = (() => {
    if (process.stdin.isTTY) return ""; // ручной запуск без payload — прямой режим
    try {
      return readFileSync(0, "utf8");
    } catch {
      return "";
    }
  })();
  let payloadCwd = null;
  let payloadCommand = "";
  try {
    const payload = rawStdin.trim() ? JSON.parse(rawStdin) : null;
    payloadCwd = payload?.cwd ?? null;
    const c = payload?.tool_input?.command ?? payload?.input?.command ?? "";
    payloadCommand = typeof c === "string" ? c : "";
  } catch {
    payloadCwd = null;
  }

  // Исполняемая часть команды: без тел heredoc и содержимого кавычек. Иначе файл или
  // сообщение со словами «git commit» внутри (`cat > README <<EOF … EOF`) — ложный коммит.
  // Цена: `sh -c "git commit"` адаптер не увидит — его догонит git-хук проекта.
  const stripHeredocs = (command) =>
    command.replace(/<<-?\s*(['"]?)([A-Za-z_][\w-]*)\1[^\n]*\n[\s\S]*?\n[ \t]*\2[ \t]*(?=\n|$)/g, "<<heredoc");
  const codeOnly = (command) =>
    stripHeredocs(command)
      .replace(/"(?:[^"\\]|\\.)*"|'[^']*'/g, (q) => (/[\s;&|]/.test(q) ? '""' : q));

  // каталог коммита — из самой команды: `cd <dir> && git commit`, `git -C <dir> commit`
  const unquote = (t) => t.replace(/^(["'])(.*)\1$/, "$2");
  const expandHome = (t) => (t === "~" || t.startsWith("~/") ? join(process.env.HOME || process.env.USERPROFILE || "", t.slice(1)) : t);
  const commitDir = (command, base) => {
    const code = codeOnly(command);
    const commitAt = code.search(/\bgit\b[^\n|;&]*\bcommit\b/);
    if (commitAt < 0) return base;
    let dir = base;
    for (const m of code.slice(0, commitAt).matchAll(/(?:^|[;&|]\s*|\(\s*)cd\s+("[^"]*"|'[^']*'|[^\s;&|)]+)/g)) {
      dir = resolve(dir, expandHome(unquote(m[1])));
    }
    const gitC = code.slice(commitAt).match(/^git\s+(?:-c\s+\S+\s+)*-C\s+("[^"]*"|'[^']*'|\S+)/);
    if (gitC) dir = resolve(dir, expandHome(unquote(gitC[1])));
    return dir;
  };

  const gitTop = (dir) => {
    const r = spawnSync("git", ["rev-parse", "--show-toplevel"], { cwd: dir, encoding: "utf8" });
    return r.status === 0 ? r.stdout.trim() : null;
  };
  // глобальный хук (~/.agent-toolkit/gate/pre-commit) гейтит тот репозиторий, где агент коммитит
  const sessionDir = payloadCwd || process.env.CLAUDE_PROJECT_DIR || process.cwd();
  const repoDir = inRepoHook ? dirname(scriptDir) : gitTop(commitDir(payloadCommand, sessionDir));
  if (!repoDir) process.exit(0); // не git-репозиторий — коммитить нечего
  const DEFAULT_NPM_GATES = ["lint", "typecheck", "complexity", "test", "tlc"];
  const HUMAN_ENV = "AGENT_TOOLKIT_HUMAN_APPROVED";

  // --- конфиг ---

  let config = {};
  const configPath = join(repoDir, ".agents", "gate.json");
  if (existsSync(configPath)) {
    try {
      config = JSON.parse(readFileSync(configPath, "utf8"));
    } catch {
      console.error(`[gate] ${configPath} не парсится как JSON — гейтить вслепую отказываюсь.`);
      process.exit(2);
    }
  }
  // неверный тип — не «защиты нет», а ошибка конфигурации: молчаливый пропуск денег хуже блока
  for (const key of ["gates", "protected"]) {
    if (config[key] !== undefined && !Array.isArray(config[key])) {
      console.error(`[gate] ${configPath}: «${key}» должен быть массивом — гейтить вслепую отказываюсь.`);
      process.exit(2);
    }
  }
  const GATE_TIMEOUT_MS =
    Number(process.env.AGENT_TOOLKIT_GATE_TIMEOUT_MS) || (Number(config.timeoutSec) || 120) * 1000; // на один гейт

  // --- stdin / режим ---


  const commandFrom = (raw) => {
    if (!raw) return null;
    try {
      const payload = JSON.parse(raw);
      const command = payload?.tool_input?.command ?? payload?.input?.command ?? "";
      return typeof command === "string" ? command : null; // не Bash-команда — не наше событие
    } catch {
      return null; // нечитаемый payload: никогда не блокируем
    }
  };

  const COMMIT_SEGMENT_RE = /\bgit\b[^\n|;&]*\bcommit\b[^\n|;&]*/g;
  const commitSegments = (command) => command.match(COMMIT_SEGMENT_RE) ?? [];
  const isGitCommit = (command) => {
    if (!command) return false;
    // `git ... commit`, включая `git -C path commit`; справка — только если она в самом
    // commit-сегменте (`... && ls --help` не делает коммит справкой)
    return commitSegments(codeOnly(command)).some((seg) => !/\s--help\b/.test(seg) && !/\bgit\s+help\b/.test(seg));
  };

  // обход проверок агентом: смотрим на команду без содержимого кавычек (сообщение коммита
  // может законно содержать «-n» или «--no-verify» как текст)
  const bypassAttempt = (command) => {
    const code = stripHeredocs(command);
    const bare = code.replace(/"(?:[^"\\]|\\.)*"|'[^']*'/g, '""');
    // без кавычек и экранирования: `HUMAN_''APPROVED`, `core."hooksPath"` склеиваются обратно
    const glued = code.replace(/['"\\]/g, "");
    for (const seg of commitSegments(bare)) {
      // git принимает однозначные сокращения длинных опций: --no-veri, --no-verif
      if (/\s--no-veri[a-z]*\b/.test(seg)) return "`--no-verify` отключает гейт";
      if (/\scommit\b.*\s-[a-zA-Z]*n[a-zA-Z]*\b/.test(seg)) return "`-n` (= --no-verify) отключает гейт";
    }
    if (/core\.hookspath/i.test(glued)) return "подмена core.hooksPath отключает гейт";
    if (glued.includes(HUMAN_ENV)) return `${HUMAN_ENV} — одобрение человека; агент не выставляет его сам`;
    return null;
  };

  // --- сверка дерева с индексом ---

  const RUNTIME_PATHS = [".agents/events.jsonl", "tasks/.locks/"];
  // неотслеживаемые файлы блокируют намеренно: тесты видят новый модуль на диске, а в коммит
  // он не попадёт — в чистом клоне сборка упадёт. Лишнее — в .gitignore.
  const treeMatchesIndex = () => {
    const res = spawnSync("git", ["status", "--porcelain", "--untracked-files=all"], { cwd: repoDir, encoding: "utf8" });
    if (res.status !== 0) {
      console.error("[gate] не удалось выполнить `git status` — сверку дерева с индексом пропускаю");
      return true; // не блокируем из-за невозможности проверить
    }
    const diverged = [];
    for (const line of res.stdout.split("\n")) {
      if (!line.trim()) continue;
      const x = line[0];
      const y = line[1] ?? " ";
      // '??' — неотслеживаемое; Y ≠ ' ' при X ≠ '?' — правки не в индексе:
      // в обоих случаях тесты гоняются по состоянию, отличному от коммита
      const path = line.slice(3);
      // рантайм доски (лог событий, lock-файлы) — не часть коммита и не влияет на тесты
      if (RUNTIME_PATHS.some((r) => path === r || path.startsWith(r))) continue;
      if (x === "?" || (y !== " " && x !== "?")) diverged.push(path);
    }
    if (diverged.length === 0) return true;
    console.error(
      `[gate] Рабочее дерево расходится с тем, что уйдёт в коммит:\n` +
        diverged.map((f) => `  ${f}`).join("\n") +
        `\nГейт проверяет рабочее дерево, а коммит фиксирует индекс — закоммитилось бы непроверенное.\n` +
        `Сделай \`git add -A\` (или stash лишнее), затем повтори коммит.`
    );
    return false;
  };

  // --- защищённые пути ---

  const globToRegExp = (glob) => {
    // семантика как в .gitignore: слэш в начале или в середине — привязка к корню;
    // без него (`migrations/`, `secrets.env`) — совпадение на любой глубине
    const raw = glob.trim();
    const anchored = raw.replace(/\/$/, "").includes("/");
    let g = raw.replace(/^\.?\//, "");
    if (g.endsWith("/")) g += "**";
    let re = "";
    for (let i = 0; i < g.length; i++) {
      const c = g[i];
      if (c === "*" && g[i + 1] === "*") {
        re += ".*";
        i++;
        if (g[i + 1] === "/") i++;
      } else if (c === "*") re += "[^/]*";
      else if (c === "?") re += "[^/]";
      else re += c.replace(/[.+^${}()|[\]\\]/g, "\\$&");
    }
    return new RegExp(anchored ? `^${re}$` : `(^|/)${re}(/|$)`);
  };

  const protectedViolations = () => {
    const globs = Array.isArray(config.protected) ? config.protected : [];
    if (globs.length === 0) return [];
    // --no-renames: переименование из защищённого пути видно как удаление старого имени;
    // -z: имена без кавычек и \-экранирования (не-ASCII пути иначе не совпадут с шаблоном)
    const res = spawnSync("git", ["diff", "--cached", "--name-only", "--no-renames", "-z"], { cwd: repoDir, encoding: "utf8" });
    if (res.status !== 0) {
      console.error("[gate] не удалось получить список файлов коммита — защищённые пути проверить нельзя, блокирую.");
      process.exit(2);
    }
    const patterns = globs.map((g) => ({ g, re: globToRegExp(String(g)) }));
    return res.stdout
      .split("\0")
      .filter(Boolean)
      .flatMap((f) => patterns.filter((p) => p.re.test(f)).map((p) => `${f}  (правило: ${p.g})`));
  };

  // --- гейты ---

  const run = ({ name, cmd, args }) => {
    // shell-строка — только для команд из gate.json (их пишет владелец репо) и для npm на Windows
    const res = args
      ? spawnSync(cmd, args, { cwd: repoDir, encoding: "utf8", timeout: GATE_TIMEOUT_MS })
      : spawnSync(cmd, { cwd: repoDir, encoding: "utf8", timeout: GATE_TIMEOUT_MS, shell: true });
    const timedOut = res.error?.code === "ETIMEDOUT" || res.signal === "SIGTERM";
    const spawnError = !timedOut && res.error ? `${res.error.code ?? ""}: ${res.error.message}` : null;
    return { name, ok: !timedOut && !spawnError && res.status === 0, timedOut, spawnError, output: (res.stdout || "") + (res.stderr || "") };
  };

  const resolveGates = () => {
    if (Array.isArray(config.gates)) {
      return config.gates
        .filter((g) => g && typeof g.run === "string" && g.run.trim())
        .map((g, i) => ({ name: g.name || `gate${i + 1}`, cmd: g.run }));
    }
    const pkgPath = join(repoDir, "package.json");
    if (!existsSync(pkgPath)) return null;
    let scripts = {};
    try {
      scripts = JSON.parse(readFileSync(pkgPath, "utf8")).scripts ?? {};
    } catch {
      console.error("[gate] package.json не парсится как JSON — гейтить вслепую отказываюсь.");
      process.exit(2);
    }
    // Windows: npm — это npm.cmd, прямой spawn без оболочки запрещён (EINVAL)
    return DEFAULT_NPM_GATES.filter((s) => scripts[s]).map((s) =>
      process.platform === "win32" ? { name: s, cmd: `npm run --if-present ${s}` } : { name: s, cmd: "npm", args: ["run", "--if-present", s] }
    );
  };

  // --- запуск ---

  const raw = rawStdin;
  if (raw.trim().length > 0) {
    // payload-режим (ZCode/Claude Code): гейтим только `git commit`.
    // Пустой stdin — прямой режим git-хука: гейтим всегда.
    const command = commandFrom(raw);
    if (!isGitCommit(command)) process.exit(0);
    const bypass = bypassAttempt(command);
    if (bypass) {
      console.error(`[gate] Коммит заблокирован: ${bypass}. Агент не обходит свои проверки — почини причину или спроси человека.`);
      process.exit(2);
    }
    // глобальный хук в проекте со своим git-хуком тулкита: обход проверен, гейт прогонит git-хук
    if (!inRepoHook) {
      const hooksPath = spawnSync("git", ["config", "--get", "core.hooksPath"], { cwd: repoDir, encoding: "utf8" }).stdout?.trim();
      if (hooksPath === ".githooks" && existsSync(join(repoDir, ".githooks", "pre-commit"))) process.exit(0);
    }
  }

  const violations = protectedViolations();
  if (violations.length > 0) {
    if (process.env[HUMAN_ENV] === "1") {
      console.error(`[gate] защищённые пути изменены с одобрением человека (${HUMAN_ENV}=1):\n${violations.map((v) => `  ${v}`).join("\n")}`);
    } else {
      console.error(
        `[gate] Коммит трогает защищённые пути (необратимое: деньги, данные, внешние системы):\n` +
          violations.map((v) => `  ${v}`).join("\n") +
          `\nТакие изменения принимает человек. Покажи ему дифф; одобренный коммит он делает сам:\n` +
          `  ${HUMAN_ENV}=1 git commit ...`
      );
      process.exit(2);
    }
  }

  // модели TLA+ в проекте (spec/tla/**/X.tla + X.cfg) проверяются TLC всегда — явно объявлять
  // гейт не нужно: без формальной проверки код с инвариантами не принимается
  const modelGate = (declared) => {
    if ((declared ?? []).some((g) => g.name === "tlc")) return null; // проект объявил свой
    if (!existsSync(join(repoDir, "spec", "tla"))) return null;
    const tlc = [join(repoDir, ".agents", "bin", "tlc.mjs"), join(scriptDir, "..", "bin", "tlc.mjs"), join(homedir(), ".agent-toolkit", "bin", "tlc.mjs")].find((p) => existsSync(p));
    if (!tlc) {
      console.error("[gate] в проекте есть spec/tla/, но нет tlc.mjs (agent-toolkit) — проверить модели нечем, блокирую. Установи: node <agent-toolkit>/install.mjs");
      process.exit(2);
    }
    const found = spawnSync(process.execPath, [tlc, "--find"], { cwd: repoDir, encoding: "utf8" });
    return found.status === 0 ? { name: "tlc", cmd: process.execPath, args: [tlc] } : null;
  };
  let gates = resolveGates();
  const tlcGate = modelGate(gates);
  if (tlcGate) gates = [...(gates ?? []), tlcGate];
  if (gates === null) {
    console.error("[gate] нет ни .agents/gate.json, ни package.json — гейтов нет, коммит проходит НЕПРОВЕРЕННЫМ.");
    process.exit(0);
  }
  if (gates.length === 0) {
    console.error(`[gate] гейты не объявлены (package.json: ${DEFAULT_NPM_GATES.join("/")}; или .agents/gate.json) — коммит проходит НЕПРОВЕРЕННЫМ.`);
    process.exit(0);
  }

  // сверка дерева нужна только тем, кто гоняет проверки: без гейтов сверять нечего
  if (!treeMatchesIndex()) process.exit(2);

  for (const g of gates) {
    // fail-fast: первый упавший гейт останавливает — гонять остальные на красном дереве бессмысленно
    const r = run(g);
    if (!r.ok) {
      if (r.timedOut) {
        console.error(`[gate] гейт \`${r.name}\` не уложился в ${GATE_TIMEOUT_MS / 1000} с (watch-режим?). Коммит заблокирован.`);
      } else if (r.spawnError) {
        console.error(`[gate] не удалось запустить гейт \`${r.name}\`: ${r.spawnError}`);
      } else {
        console.error(`\n[gate] гейт \`${r.name}\` упал:\n${r.output.slice(-4000)}`);
      }
      console.error(`[gate] Коммит заблокирован: гейт \`${r.name}\`.`);
      process.exit(2);
    }
  }
  process.exit(0);
}
