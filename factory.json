      "claude-code":  { "provider": "acp-opencode", "model": "opencode-go/deepseek-v4.1-flash" } } },
    "critic":   { "reasoning": "high", "environment": "same", "crossReview": {
      "acp-opencode": { "provider": "claude-code", "model": "claude-sonnet-5-5", "permission": "auto" },
